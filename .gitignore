# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Uploaded media (don't commit warehouse photos to Git)
mediafiles/

# Collected static files (generated by collectstatic in the container)
staticfiles/

# Environment variables 
.env
# The demo stack's MCP server env (API token, secret URL path) -- .env
# above already covers demo/.env; this is the separate mcp.env file
# demo/docker-compose.yml's mcp service loads. (This exact gap --
# mcp.env slipping past a bare .env rule -- got a real secret
# committed on 2026-10-15; see git history for the rotation that
# followed.)
mcp.env

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db

# VS Code settings
.vscode/

# Backups (contains DB dumps + media — never commit)
backup/
backups/
backup.log

# ZAP scan output/config — references the real production domain
zap.yaml
zap_report.html
# Scratch folder used when moving files that need manual deletion
_to_delete/

# Stray one-off files that have ended up in the project root -- never
# commit these: a raw DB dump can carry real client/order data, and a
# vendor catalog PDF isn't part of the app.
/*.sql
/*.pdf
