# Copy to .env in this directory. Never commit the real .env.
#
# This is a SEPARATE environment from ../.env (production) -- separate
# database, separate secret key, separate tunnel token. Never copy values
# over from the production .env.

# --- Django ---
DJANGO_SECRET_KEY=replace-with-a-long-random-string
# True is fine here: this Django instance is never exposed publicly (only
# the `mcp` service is, via its own Cloudflare tunnel -- see
# docker-compose.yml) -- it's only reached from inside this stack's own
# docker network, by the `mcp` service and by you at 127.0.0.1:8010.
DJANGO_DEBUG=True
# "web" is required: the `mcp` service's HTTP client hits this container by
# its Compose service name (http://web:8000), so Django must accept that as
# a valid Host header even though nothing public ever sends it.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=

# --- Database (this stack's own Postgres -- see docker-compose.yml's
# `demo_postgres_data` volume, separate from production's) ---
POSTGRES_DB=inventory_demo
POSTGRES_USER=inventory_demo_user
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60

# --- Error tracking (optional -- fine to leave blank for a demo) ---
SENTRY_DSN=

# --- Cloudflare Tunnel ---
# A NEW tunnel + hostname, created separately from production's (brief
# Section 9). Routes to this stack's `mcp` service, not `web` -- see
# docker-compose.yml's `cloudflared` service comment.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Seed data safety gate (brief Section 3: never run against the live
# IMS) --- this is deliberately always-on in THIS file specifically,
# because this .env can only ever point at the demo-only Postgres volume
# above, never at production's. Do not copy this line into ../.env.
DEMO_SEED_CONFIRM=yes
