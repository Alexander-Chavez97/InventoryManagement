# Copy to mcp.env in this directory. Never commit the real mcp.env.
# Loaded by the `mcp` service in docker-compose.yml (see mcp_server/.env.example
# for what each of these does in more detail).

# "web" resolves inside this compose project's own docker network -- it's
# the `web` service defined in docker-compose.yml, not production's.
DJANGO_API_BASE_URL=http://web:8000

# From, on this demo stack specifically:
#   docker compose exec web python manage.py create_mcp_api_user
DJANGO_API_TOKEN=

MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8100

# Optional shared secret, checked as `Authorization: Bearer <value>`.
# Confirmed NOT usable with Superhuman Go's custom-MCP connector (brief
# Section 11 resolved -- it sends no such header, captured its actual
# outbound request and there's nothing to check). Kept in case some other
# MCP client supports custom headers. Leave blank to disable.
MCP_SERVER_AUTH_TOKEN=

# The real gate for Superhuman Go: an unguessable URL path segment (brief
# Section 9's fallback, since header-based auth doesn't reach this server
# from Go's connector). Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# Paste the MCP URL into Agent Builder as https://<host>/<this value>/ --
# any other path 404s before reaching the MCP app at all.
MCP_SERVER_SECRET_PATH=

# The public hostname this server is reached at (no scheme, no path).
# Required so FastMCP's own built-in DNS-rebinding protection allows
# this hostname's Host header through -- see server.py's docstring.
MCP_PUBLIC_HOSTNAME=
