# Copy to mcp.env in this directory. Never commit the real mcp.env.
# Loaded by the `mcp` service in docker-compose.yml (see mcp_server/.env.example
# for what each of these does in more detail).

# "web" resolves inside this compose project's own docker network -- it's
# the `web` service defined in docker-compose.yml, not production's.
DJANGO_API_BASE_URL=http://web:8000

# From, on this demo stack specifically:
#   docker compose exec web python manage.py create_mcp_api_user
DJANGO_API_TOKEN=c7b8a1915de6be1418822ba3755baeeab5c5ab8e

MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8100

# Optional shared secret -- independent of whatever auth Superhuman Go's
# custom-MCP support turns out to have (brief Section 11, still
# unconfirmed). Leave blank to rely on the Cloudflare tunnel alone.
MCP_SERVER_AUTH_TOKEN=

MCP_SERVER_SECRET_PATH=WK0fN2LZZaZSmB326XRqSOlzp7r8rBZ2

MCP_PUBLIC_HOSTNAME=mcp.novastartx.com
