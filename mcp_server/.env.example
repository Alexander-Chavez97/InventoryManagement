# Copy to .env and fill in. Never commit the real .env.

# Base URL of the demo Django IMS mockup this server talks to. Inside the
# demo docker-compose network this is normally the web service's name, e.g.
# http://web:8000 -- NOT the production hostname, and NOT the production
# stack (brief Section 3: this must only ever point at the fake-seeded demo
# instance).
DJANGO_API_BASE_URL=http://web:8000

# Token for the dedicated, non-staff demo-instance API account. Generate it
# on the DEMO instance with:
#   python manage.py create_mcp_api_user
DJANGO_API_TOKEN=

# Host/port this server binds to.
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8100

# Optional shared secret. When set, every request to this server must send
# `Authorization: Bearer <value>` or get a 401 -- defense-in-depth alongside
# whatever Cloudflare-side protection the demo tunnel ends up using (brief
# Section 9). Leave blank to disable (rely on Cloudflare alone).
MCP_SERVER_AUTH_TOKEN=
